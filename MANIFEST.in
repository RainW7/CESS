# Publish the runtime and its reproducible test closure, not local checkpoints.
prune .git
prune .envs
prune build
prune dist
prune docs
prune archive
prune CESS_v0.8.6
prune CESS_v0.8.5
prune CESS_kinematics
prune jupyter_notebooks

include pyproject.toml setup.cfg MANIFEST.in
include .gitignore .gitattributes
include README.md README_zh-CN.md CHANGELOG.md CHANGELOG_zh-CN.md
include LICENSE RESOURCE_NOTICE.md RESOURCE_NOTICE_zh-CN.md
recursive-include src/cess *.py
include src/cess/data/emulator_parameters.json
recursive-include src/cess/data/basic_file *.fits *.pkl
recursive-include src/cess/data/csst_sls_tp *.fits
recursive-include src/cess/data/csst_phot_tp *.fits
recursive-include requirements *.txt
recursive-include tests *.py
recursive-include tests/baselines *.tar.gz *.json
include examples/README.md examples/README_zh-CN.md examples/make_toy_input.py
include cess_h5_viewer.py
include scripts/gravity/README.md scripts/gravity/README_zh-CN.md
include scripts/gravity/preflight.sh scripts/gravity/cess.pbs
include scripts/gravity/catalogue_array.py scripts/gravity/ARRAY.md scripts/gravity/ARRAY_zh-CN.md
include docs/QUICKSTART.md docs/QUICKSTART_zh-CN.md
include docs/USER_GUIDE.md docs/USER_GUIDE_zh-CN.md
include docs/INSTALL.md docs/INSTALL_zh-CN.md
include docs/OUTPUT_LAYOUT.md docs/OUTPUT_LAYOUT_zh-CN.md
include docs/VIEWER.md docs/VIEWER_zh-CN.md
include docs/COMMANDS.md docs/COMMANDS_zh-CN.md
include docs/SCIENCE_MODELS.md docs/SCIENCE_MODELS_zh-CN.md
include docs/INSTRUMENT_MODEL_251106917.md docs/INSTRUMENT_MODEL_251106917_zh-CN.md
include docs/MGE_MODELS.md docs/MGE_MODELS_zh-CN.md docs/MGE_BUNDLE_FORMAT.md
include docs/RELEASE_NOTES_v0.9.0.md docs/RELEASE_NOTES_v0.9.0_zh-CN.md
include docs/RESOURCE_MANIFEST.json
include docs/migration_py312_20261023/requirements-macos-arm64-py312.lock

global-exclude *.h5 *.hdf5 *.py[cod] .DS_Store

# Only these two small HDF5 examples are distributed.
include examples/toy_input.hdf5 examples/toy_output.hdf5
